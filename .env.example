# Copy file này thành .env rồi thay bằng IP LAN của máy đang chạy backend.
# Lấy IP: mở PowerShell chạy `ipconfig`, tìm dòng "IPv4 Address" của card Wi-Fi.
#
# KHÔNG dùng localhost hay 127.0.0.1 — điện thoại sẽ hiểu đó là chính nó, không phải laptop.
# Chỉ biến có tiền tố EXPO_PUBLIC_ mới được Expo đưa vào bundle.
EXPO_PUBLIC_API_URL=http://192.168.1.14:8080
